<main id="conteudo">
<section class="blk app-page" id="agendinha">
  <input class="vista" type="radio" name="vista" id="v-lista" checked>
  <input class="vista" type="radio" name="vista" id="v-grade">
  <div class="wrap">
    <div class="week-board">
      <div class="week-toolbar">
        <a class="week-shift" href="<%= day_path(week.prev_week) %>" aria-label="Semana anterior">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10.2 2.4 4.6 8l5.6 5.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="vh">Semana anterior</span>
        </a>
        <div class="week-strip">
          <% week.days.each do |cell| %>
            <a class="week-day<%= ' is-on' if cell.selected %><%= ' is-today' if cell.today %><%= ' is-sat' if cell.saturday %>" href="<%= day_path(cell.date) %>">
              <span class="week-dow"><%= cell.label %></span>
              <span class="week-num"><%= cell.date.day %></span>
              <span class="week-count"><% if cell.today %><span class="week-live" aria-hidden="true"></span><% end %><%= week_count_label(cell) %></span>
            </a>
          <% end %>
        </div>
        <a class="week-shift" href="<%= day_path(week.next_week) %>" aria-label="Próxima semana">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5.8 2.4 11.4 8l-5.6 5.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="vh">Próxima semana</span>
        </a>
        <div class="view-toggle" role="group" aria-label="Vista">
          <label for="v-lista">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 4h10M3 8h10M3 12h10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            Lista
          </label>
          <label for="v-grade">
            <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2.5" y="2.5" width="4.5" height="4.5" rx=".6" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="9" y="2.5" width="4.5" height="4.5" rx=".6" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="2.5" y="9" width="4.5" height="4.5" rx=".6" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="9" y="9" width="4.5" height="4.5" rx=".6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
            Grade
          </label>
        </div>
      </div>
      <div class="sport-pills" role="group" aria-label="Filtro por esporte">
        <label for="f-all" class="sport-pill">Todos <span class="sport-pill-count"><%= games.size %></span></label>
        <% sports.each do |sport| %>
          <label for="f-<%= sport.slug %>" class="sport-pill"><%= sport.name %> <span class="sport-pill-count"><%= day_sport_counts[sport.slug] %></span></label>
        <% end %>
      </div>
    </div>

    <div class="agenda-grid">
      <div class="cal-pane">
        <div class="day-head">
          <h3><%= month_title(day) %></h3>
          <span><%= day.strftime("%d/%m") %></span>
        </div>
        <div class="cal" aria-label="Calendário de <%= month_title(day) %>">
          <% grid.weekday_labels.each do |label| %>
            <span class="cal-dow"><%= label %></span>
          <% end %>
          <% grid.cells.each do |cell| %>
            <div class="cal-cell<%= ' is-out' unless cell.in_month %><%= ' is-marked' if cell.marked %><%= ' is-on' if cell.date == day %>">
              <a class="cal-num" href="<%= day_path(cell.date) %>"><%= cell.date.day %></a>
              <% (month_games[cell.date] || []).each do |game| %>
                <%= cal_event(game, day: cell.date, saved: saved_by_title[[cell.date, game.title]]) %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="list-pane">
        <% if on_day.any? %>
        <div class="mine">
          <% on_day.each do |item| %>
            <%= saved_item(item) %>
          <% end %>
        </div>
        <% end %>

        <% open_games = games.reject { |game| saved_by_title[[day, game.title]] } %>
        <% if games.any? %>
          <% if open_games.any? %>
          <div class="game-cards" role="group" aria-label="Jogos de <%= day.strftime('%d/%m') %>">
            <% open_games.each do |game| %>
              <form method="post" action="/agenda" class="game-card" data-s="<%= game.sport %>">
                <input type="hidden" name="authenticity_token" value="<%= csrf_token %>">
                <input type="hidden" name="day" value="<%= day.iso8601 %>">
                <input type="hidden" name="sport" value="<%= game.sport %>">
                <input type="hidden" name="title" value="<%= game.title %>">
                <input type="hidden" name="kicks_at" value="<%= game.clock %>">
                <input type="hidden" name="note" value="<%= game.note %>">
                <input type="hidden" name="watch" value="<%= game.where %>">
                <button type="submit" aria-label="Colocar <%= game.title %> no dia <%= day.strftime('%d/%m') %>">
                  <span class="game-card-clock"><%= game.clock %></span>
                  <span>
                    <span class="comp"><%= game.competition %></span>
                    <strong><%= game.title %></strong>
                    <span class="game-card-where"><%= game.where %></span>
                    <span class="game-card-note"><%= game.note %></span>
                  </span>
                </button>
              </form>
            <% end %>
          </div>
          <% end %>
        <% else %>
          <p class="empty-day note">Sem jogos na TV neste dia.</p>
        <% end %>
      </div>
    </div>
  </div>
</section>
</main>
