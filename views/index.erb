<main id="conteudo">

<section data-theme="ink" class="blk blk-fut blk-nfl blk-nba blk-auto">
  <div class="wrap">
    <p class="kicker">/// 08 · nov · 26</p>
    <h1>Domingo lotado.</h1>
    <p class="lead">Futebol, NFL, NBA e automobilismo no mesmo dia. Horário de Brasília. Quando dois jogos caem no mesmo minuto, fica o que eu escolheria — o resto vai para o segundo aparelho.</p>
    <div class="hero-meta">
      <span>Atualizado <b>8 nov, 12h</b></span>
      <span>Grade <b>hoje + semana</b></span>
      <span>F1 <b>Interlagos 14h</b></span>
    </div>
  </div>
</section>

<section data-theme="paper" class="blk blk-fut blk-nfl blk-nba blk-auto" id="agendinha">
  <div class="wrap">
    <p class="kicker">/// 00 · agendinha · <a href="/agenda">minha agenda</a></p>
    <h2>Clica no jogo. Entra no dia.</h2>
    <p class="lead">O calendário escolhe o dia. O card do confronto escreve. A grade de baixo continua a da TV — isto aqui é o que você resolveu assistir.</p>

    <div class="agenda-grid">
      <div>
        <div class="day-head">
          <h3><%= month_title(day) %></h3>
          <span><%= day.strftime("%d/%m") %></span>
        </div>
        <div class="cal" aria-label="Calendário de <%= month_title(day) %>">
          <% grid.weekday_labels.each do |label| %>
            <span><%= label %></span>
          <% end %>
          <% grid.cells.each do |cell| %>
            <a
              href="/?dia=<%= cell.date.iso8601 %>"
              class="<%= 'is-out' unless cell.in_month %><%= ' is-marked' if cell.marked %><%= ' is-on' if cell.date == day %>"
            ><%= cell.date.day %></a>
          <% end %>
        </div>
      </div>

      <div>
        <div class="mine">
          <% if on_day.empty? %>
            <p class="note"><%= games.any? ? "Nada neste dia. Clica num jogo." : "Nada neste dia. Clica num esporte." %></p>
          <% else %>
            <% on_day.each do |item| %>
              <article class="ev" data-s="<%= sport_filter(item.sport) %>">
                <time datetime="<%= item.starts_on.iso8601 %>"><%= item.starts_on.strftime("%d/%m") %></time>
                <div>
                  <p class="comp"><%= sport_name(item.sport) %></p>
                  <h3><a href="/agenda/<%= item.id %>"><%= item.title %></a></h3>
                  <%= item_actions(item) %>
                </div>
              </article>
            <% end %>
          <% end %>
        </div>

        <% if games.any? %>
          <div class="game-cards" role="group" aria-label="Colocar jogo no dia <%= day.strftime('%d/%m') %>">
            <% games.each do |game| %>
              <form method="post" action="/agenda" class="game-card" data-s="<%= sport_filter(game.sport) %>">
                <input type="hidden" name="authenticity_token" value="<%= csrf_token %>">
                <input type="hidden" name="day" value="<%= day.iso8601 %>">
                <input type="hidden" name="sport" value="<%= game.sport %>">
                <input type="hidden" name="title" value="<%= game.title %>">
                <button type="submit" aria-label="Colocar <%= game.title %> no dia <%= day.strftime('%d/%m') %>">
                  <span class="game-card-clock"><%= game.clock %></span>
                  <span>
                    <span class="comp"><%= game.competition %></span>
                    <strong><%= game.title %></strong>
                  </span>
                  <span class="sport-card-hint">coloca no dia</span>
                </button>
              </form>
            <% end %>
          </div>
        <% else %>
          <p class="note">Nenhum jogo na grade neste dia. Clica num esporte se quiser marcar mesmo assim.</p>
          <div class="sport-cards" role="group" aria-label="Colocar esporte no dia <%= day.strftime('%d/%m') %>">
            <% sports.each do |sport| %>
              <form method="post" action="/agenda" class="sport-card">
                <input type="hidden" name="authenticity_token" value="<%= csrf_token %>">
                <input type="hidden" name="day" value="<%= day.iso8601 %>">
                <input type="hidden" name="sport" value="<%= sport.slug %>">
                <button type="submit" aria-label="Colocar <%= sport.name %> no dia <%= day.strftime('%d/%m') %>">
                  <span class="sport-card-day"><%= day.strftime("%d/%m") %></span>
                  <strong><%= sport.name %></strong>
                  <span class="sport-card-hint">coloca no dia</span>
                </button>
              </form>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

