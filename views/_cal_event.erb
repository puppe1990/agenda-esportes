<% if saved %>
  <a class="cal-event is-saved" data-s="<%= game.sport %>" href="/agenda/<%= saved.id %>">
    <span class="cal-event-clock"><%= game.clock %></span>
    <span class="cal-event-title"><%= game.title %></span>
  </a>
<% else %>
  <form method="post" action="/agenda" class="cal-event" data-s="<%= game.sport %>">
    <input type="hidden" name="authenticity_token" value="<%= csrf_token %>">
    <input type="hidden" name="day" value="<%= day.iso8601 %>">
    <input type="hidden" name="sport" value="<%= game.sport %>">
    <input type="hidden" name="title" value="<%= game.title %>">
    <input type="hidden" name="kicks_at" value="<%= game.clock %>">
    <input type="hidden" name="note" value="<%= game.note %>">
    <input type="hidden" name="watch" value="<%= game.where %>">
    <button type="submit" aria-label="Colocar <%= game.title %> no dia <%= day.strftime('%d/%m') %>">
      <span class="cal-event-clock"><%= game.clock %></span>
      <span class="cal-event-title"><%= game.title %></span>
    </button>
  </form>
<% end %>
