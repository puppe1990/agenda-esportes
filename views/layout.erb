<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Agenda de esportes</title>
<meta name="description" content="Jogos da TV nos próximos 7 dias.">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#0b0e14">
<!-- Empty home has no forms; POST still needs the token. -->
<meta name="csrf-token" content="<%= csrf_token %>">
<meta property="og:title" content="Agenda de esportes">
<meta property="og:description" content="Jogos da TV nos próximos 7 dias.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://agenda-esportes.sites.gestaobem.com">
<meta property="og:locale" content="pt_BR">
<meta property="og:image" content="https://agenda-esportes.sites.gestaobem.com/og.png">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Agenda de esportes: faixa da semana dark mint. Jogos da TV nos próximos 7 dias.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Agenda de esportes">
<meta name="twitter:description" content="Jogos da TV nos próximos 7 dias.">
<meta name="twitter:image" content="https://agenda-esportes.sites.gestaobem.com/og.png">
<link rel="preload" href="/fonts/instrument-serif-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/ibm-plex-sans-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="stylesheet" href="<%= asset_path("app.css") %>">
<style><%= filter_css %></style>
</head>
<body>
<a class="skip" href="#conteudo">Pular para o conteúdo</a>
<input class="filtro" type="radio" name="filtro" id="f-all" checked>
<% Array(@filter_sports).each do |sport| %>
<input class="filtro" type="radio" name="filtro" id="f-<%= sport.slug %>">
<% end %>

<div class="grain" aria-hidden="true"></div>

<nav class="bar" aria-label="Filtro por esporte">
  <div class="bar-inner">
    <a class="brand" href="/">Agenda · BRT</a>
    <a class="mine-link" href="/agenda">Minha agenda</a>
    <% if @show_bar_filters %>
    <label for="f-all">Tudo</label>
    <% Array(@filter_sports).each do |sport| %>
    <label for="f-<%= sport.slug %>"><%= sport.name %></label>
    <% end %>
    <% end %>
  </div>
</nav>

<%= yield %>
</body>
</html>
