<main id="conteudo">
<section data-theme="paper" class="blk blk-fut blk-nfl blk-nba blk-auto app-page">
  <div class="wrap">
    <div class="mine mine-full">
      <% if items.empty? %>
        <p class="note">Nada na agenda. <a href="/">Escolher um jogo</a></p>
      <% else %>
        <% items.each do |item| %>
          <article class="ev" data-s="<%= sport_filter(item.sport) %>">
            <time datetime="<%= item.starts_on.iso8601 %>"><%= item.starts_on.strftime("%d/%m") %></time>
            <div>
              <p class="comp"><%= sport_name(item.sport) %></p>
              <h3><a href="/agenda/<%= item.id %>"><%= item.title %></a></h3>
              <%= item_actions(item) %>
            </div>
          </article>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
</main>
